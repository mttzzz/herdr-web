# Copy to the plugin config dir as `.env` to override defaults:
#   $(herdr plugin config-dir herdr-web)/.env
# (or to a `.env` in the repo root when running `bun server/server.ts` by hand)

# TCP port for the web mirror.
HERDR_WEB_PORT=8793

# Bind address. 127.0.0.1 = this machine only (default, safe).
# 0.0.0.0 = reachable from the LAN (phone/tablet) — ANYONE with the token URL
# gets a full interactive terminal as your user. Only enable on trusted networks.
HERDR_WEB_HOST=127.0.0.1

# herdr session to mirror. Empty = default session.
HERDR_WEB_SESSION=

# Max simultaneous browser tabs (each one is a real herdr client process).
HERDR_WEB_MAX_CLIENTS=6

# How long (ms) a tab's herdr client waits for the tab to come back after its socket closed
# (a reload, a dropped Wi-Fi): the tab gets the running client instead of a new attach.
# 0 = end it at once.
# HERDR_WEB_LINGER_MS=15000

# Auth token file. Auto-generated on first start (mode 600).
# HERDR_WEB_TOKEN_FILE=/path/to/token

# Explicit bun binary for the ctl script (default: `command -v bun` or ~/.bun/bin/bun).
# HERDR_WEB_BUN=

# Set to 0 to stop `web-ctl.sh open` from launching a browser window.
# HERDR_WEB_OPEN=1

# Auth. token (default) = ?token=… once, then an HttpOnly cookie.
# off = no auth at all: anyone who reaches the port gets a full terminal as your user.
# Only for a network you control end to end.
# HERDR_WEB_AUTH=token
